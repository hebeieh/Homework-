def solve():
    s = input().strip()
    if not s:
        print(0)
        return

    n = len(s)
    ans = 0  
    t = ""

    for i in range(n):
        t += s[i]
        rev = t[::-1]
        m = len(rev)
        
        p = [0] * m 
        max = 0 
        
        for j in range(1, m):
            k = p[j - 1]
            while k > 0 and rev[j] != rev[k]:
                k = p[k - 1]
            if rev[j] == rev[k]:
                k += 1
            p[j] = k
            
            if k > max:
                max = k
                
        ans += m - max

    print(ans)

if __name__ == '__main__':
    solve()
